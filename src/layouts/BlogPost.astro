---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & { minutos: number };

const { title, description, pubDate, tema, minutos } = Astro.props;
---

<Base title={title} description={description}>
	<main id="post">
		<div class="wrap">
			<div class="post-head">
				<a class="back" href="/#notas">← Volver a las notas</a>
				<h1>{title}</h1>
				<p class="pmeta">
					<span><FormattedDate date={pubDate} /></span><span>{tema}</span><span>{minutos} min</span>
				</p>
			</div>
			<article class="prose">
				<slot />
			</article>
		</div>
	</main>
</Base>
