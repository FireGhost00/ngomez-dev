---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { readingTime } from '../../utils/readingTime';

const notas = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title={`Notas — ${SITE_TITLE}`} description="Bitácora técnica sobre IBM i, RPG, DB2 y modernización de sistemas legacy.">
	<main>
		<section id="notas">
			<div class="wrap">
				<div class="shead"><h2>Notas</h2><span class="tag">bitácora técnica</span></div>
				<div class="report">
					<div class="rhead">
						<span>Fecha</span><span>Tema</span><span>Título</span><span style="text-align:right"
							>Min</span
						>
					</div>
					{
						notas.map((nota) => (
							<a class="note" href={`/blog/${nota.id}/`}>
								<span class="d">
									<FormattedDate date={nota.data.pubDate} />
								</span>
								<span class="t">{nota.data.tema}</span>
								<div>
									<h3>{nota.data.title}</h3>
									<p>{nota.data.description}</p>
								</div>
								<span class="m">{readingTime(nota.body ?? '')}</span>
							</a>
						))
					}
				</div>
			</div>
		</section>
	</main>
</Base>
